# Copia este fichero como .env y cambia las claves. El fichero .env no se sube al repositorio.
DB_NAME=convalidafp
DB_USER=convalidafp
DB_PASSWORD=cambia-esta-clave
DB_ROOT_PASSWORD=cambia-esta-otra-clave

# Primer administrador. Se crea al arrancar solo si todavía no existe ninguno y solo si rellenas
# las dos variables. Vacías = no se crea ningún administrador. No hay contraseña por defecto.
# La contraseña debe tener al menos 12 caracteres.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Puertos en tu equipo (solo accesibles desde localhost).
FRONTEND_PORT=3000
BACKEND_PORT=8080
