# Producción. Copia este fichero como .env.prod en el servidor y rellénalo. No lo subas al repositorio.
# Uso: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Dominio público (su registro DNS A/AAAA debe apuntar ya al servidor) y correo para Let's Encrypt.
DOMAIN=convalidafp.example.com
ACME_EMAIL=cambia-este-correo@example.com

# Claves largas y aleatorias, por ejemplo: openssl rand -base64 32
DB_NAME=convalidafp
DB_USER=convalidafp
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Primer administrador: rellénalo solo para el primer arranque (contraseña de 12 caracteres o más)
# y después déjalo vacío. Vacío = no se crea ningún administrador.
ADMIN_USERNAME=
ADMIN_PASSWORD=
