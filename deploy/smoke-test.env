# Entorno de la prueba de humo de docker-compose.prod.yml (deploy/smoke-test.sh). SOLO PARA TESTS.
#
# Arranca la configuración de producción en esta máquina con «localhost» como dominio: Caddy usa
# entonces su propia autoridad de certificación local en lugar de Let's Encrypt. Todos los valores
# son de prueba y el entorno se borra al terminar. No los uses nunca en un servidor.
DOMAIN=localhost
ACME_EMAIL=pruebas@example.com
DB_NAME=convalidafp
DB_USER=convalidafp
DB_PASSWORD=solo-para-la-prueba-de-humo-db
DB_ROOT_PASSWORD=solo-para-la-prueba-de-humo-root
ADMIN_USERNAME=admin-humo
ADMIN_PASSWORD=solo-para-la-prueba-de-humo-0123
