# Proxy HTTPS de producción (docker-compose.prod.yml). Caddy obtiene y renueva solo el certificado
# de Let's Encrypt para {$DOMAIN} y redirige HTTP a HTTPS.
#
# Caddy no confía en las cabeceras X-Forwarded-* que envía el cliente: las sustituye por la IP real
# de la conexión y por «https». Nginx las pasa al backend, que solo las acepta de Caddy y de Nginx.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	reverse_proxy 172.30.0.20:80
}
