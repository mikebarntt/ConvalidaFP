# Entorno de los tests de extremo a extremo (Playwright). SOLO PARA TESTS.
#
# Todos los valores son de prueba y solo sirven para un entorno desechable que se crea y se borra
# con cada ejecución (proyecto de Compose «convalidafp-e2e»). No uses nunca estos valores en otro
# sitio. El administrador de aquí no existe en ningún otro entorno.
DB_NAME=convalidafp
DB_USER=convalidafp
DB_PASSWORD=solo-para-tests-e2e-db
DB_ROOT_PASSWORD=solo-para-tests-e2e-root

ADMIN_USERNAME=admin-e2e
ADMIN_PASSWORD=solo-para-tests-e2e-0123456789

# Puertos distintos de los del entorno local, para poder tener los dos arrancados a la vez.
FRONTEND_PORT=3100
BACKEND_PORT=8180
